# Локальная демонстрационная копия НейроРОПа на замороженном snapshot.
# Скопируйте нужные строки в свой `.env`. Секреты OpenAI/OpenRouter берите
# из обычной конфигурации проекта, сюда их не записывайте.

# Работа только с локально сохранёнными данными. Bitrix HTTP блокируется.
DEMO_MODE=true
# Замороженный московский бизнес-момент для today/yesterday/overdue.
DEMO_NOW=2026-09-18T18:00:00+03:00
# Дополнительная страховка: дневной цикл и так не стартует при DEMO_MODE=true.
DAYTIME_CYCLE_ENABLED=false
# Отдельный файл SQLite для demo-снимка. Production path не подменяйте здесь.
ROP_DB_PATH=reports/rop_assistant/demo_rop_assistant.sqlite
